const sum = fn(items: [4]i32) -> i32 {
    var total = 0;
    for (item in items) {
        total += item;
    }
    return total;
};

const make_items = fn() -> [4]i32 {
    print("generate once");
    return range(-1, 3);
};

const main = fn() -> void {
    const end = 1 + 2;
    const items: [end + 1]i32 = range(-1, end);
    print(sum(items));
    for (item in make_items()) {
        print(item);
    }

    while (false) {
        print("unreachable while body");
    }

    for (item in range(0, 5)) {
        if (item == 1) { continue; }
        if (item == 3) { break; }
        print(item);
    }
    for (item in range(4, 2)) {
        print(item);
    }

    var n = 0;
    while (n < 4) {
        n += 1;
        if (n == 2) { continue; }
        print(n);
    }
    do {
        print("once");
        continue;
    } while (false);

    do {
        n += 1;
        if (n < 6) { continue; }
        print(n);
    } while (n < 7);
};
