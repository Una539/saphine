use first: "./modules/math.zig";
use second: "./modules/math.zig";
use a: "./instance.saph";
use b: "./instance.saph";
use lang_std: "std";
use zig_std: "zig:std";

const Factory = first.Factory(i32);
const increment = fn(x: i32) -> i32 { return x + 1; };
const Wrapper = struct { use defaults: first.Defaults; };
const apply = fn(f: fn(x: i32) -> i32, x: i32) -> i32 { return f(x); };
const main = fn() -> void {
    a.value = 6;
    print(a.value);
    print(b.value);
    print(first.add(2));
    print(second.counter);
    var point: first.Alias = first.Point { .x = 3 };
    var copy = point;
    copy.bump(first.add(1));
    print(point.sum());
    print(copy.sum());
    second.counter = 7;
    print(first.make().x);
    print(first.counter);
    print(first.resourceLength());
    print(apply(first.add, 9));
    print(first.echo(i32, 13));
    print(first.requireInteger(14));
    print(first.query(1));
    print(match (first.Result.Err(first.Errors.Bad)) { .Err(_) => { 15 }, default => { 0 }, });
    print(match (first.Maybe.Some(16)) { .Some(value) => { value }, .None => { 0 }, });
    print(match (first.Maybe.None) { default => { 17 }, });
    print(match (first.Color.red) { .red => { 18 }, .blue => { 0 }, });
    var wrapper = Wrapper {};
    wrapper.count = 19;
    print(wrapper.defaults.count);
    const link = first.Link {};
    const io_type = zig_std.Io;
    print(first.runCallback(increment, 19));
    print(first.sentinel());
    const boxed = Factory { .value = 21 };
    const next = boxed.next;
    print(first.extract(i32, boxed));
};
